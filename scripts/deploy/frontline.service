[Unit]
Description=Frontline Objective Dedicated Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=frontline
Group=frontline
WorkingDirectory=/opt/frontline
ExecStart=/opt/frontline/frontline_server.x86_64 --headless --server --port 27960
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/frontline

[Install]
WantedBy=multi-user.target
